{
  "name": "excel-warehouse-summary",
  "version": "1.6.0",
  "description": "仓配订单汇总 Electron 桌面工具",
  "main": "src/main.js",
  "author": "Excel Tool",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist:fast": "electron-builder --win nsis -c.compression=store",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "appId": "com.exceltool.warehousesummary",
    "productName": "仓配订单汇总工具",
    "artifactName": "仓配订单汇总工具-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "product-preset.json",
      "warehouse-preset.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
